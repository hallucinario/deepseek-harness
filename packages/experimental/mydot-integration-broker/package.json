{
  "name": "@deepseek-ai/dsh-experimental-mydot-integration-broker",
  "description": "Isolated, account-scoped Google Calendar and Outlook broker with an enforced no-send policy",
  "version": "0.2.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/mydot-integration-broker"
  },
  "type": "module",
  "main": "lib/index.js",
